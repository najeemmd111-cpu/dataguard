{
  "name": "dataguard-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright end-to-end and axe accessibility tests for the DataGuard dashboard",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
